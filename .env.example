# Скопируйте этот файл в .env в корне проекта и заполните значения.
# Compose использует deploy/vps.env; HTTP-клиентам передайте переменные окружения.
# Не публикуйте .env и не отправляйте значения ключей в чат.

# Только для legacy CLOUD/Gemini. LOCAL не требует этого ключа.
GOOGLE_API_KEY=

# Модель генерации (смена не требует пересборки embedding-индекса).
# Варианты: gemini-2.5-flash, gemini-2.5-flash-lite, gemini-3.1-flash-lite.
# Доступность для вашего API-ключа проверяется только реальным запуском.
RAG_MODEL=gemini-2.5-flash

# Только для bot.py: токен Telegram-бота.
TELEGRAM_BOT_TOKEN=

# Только для bot.py: числовые Telegram ID администраторов через запятую.
# Пустое значение отключает доступ к административной команде /clearcache.
# Это список администраторов, а не ограничение доступа к самому боту.
TELEGRAM_ADMIN_IDS=

# Обязательно для бота: разрешённые пользователи, числовые ID через запятую.
# Пустое/неверное значение запрещает доступ. Администратор тоже должен входить в список.
TELEGRAM_ALLOWED_USER_IDS=

# Общий HTTP runtime. Секрет берётся из файла; значения ключей сюда не записывайте.
RAG_RUNTIME_URL=http://127.0.0.1:8080
RAG_SERVICE_SECRET_FILE=

# Необязательно. Пустое значение: logs/rag_metrics.jsonl в корне проекта.
# Для одновременно запущенных процессов задавайте разные файлы журналов.
RAG_METRICS_PATH=
